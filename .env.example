# ---- Core -------------------------------------------------------------------
# SQLite for local Phase-0/1 development; PostgreSQL for demo/prod.
DATABASE_URL=sqlite:///./brandwatch.db
# DATABASE_URL=postgresql+psycopg://brandwatch:brandwatch@localhost:5432/brandwatch
REDIS_URL=
# True => every provider resolves to its deterministic mock ($0, no live keys needed)
DEMO_MODE=true
# Used to sign JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-real-deployments-please-32b
# Local KEK for envelope encryption of stored API keys (32 bytes, base64). Dev only;
# production should source the KEK from a KMS / secrets manager.
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
LOCAL_KEK_B64=

# ---- Bootstrap admin (single workspace, Phase 0) ----------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# ---- Economic limits (per workspace) ----------------------------------------
ECONOMIC_LIMITS__MAX_API_CALLS=1000
ECONOMIC_LIMITS__MAX_RESIDENTIAL_GB=0
ECONOMIC_LIMITS__MAX_DAILY_SPEND=0
ECONOMIC_LIMITS__MAX_INVESTIGATION_COST=0
ECONOMIC_LIMITS__MAX_CANDIDATE_COUNT=500

# ---- Provider API keys (all optional; blank => mock) -------------------------
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
WHOISXML_API_KEY=
SERPAPI_API_KEY=
SCRAPERAPI_API_KEY=   # the fallback of SerpAPI for the Google search stream (scraperapi.com)
ABUSEIPDB_API_KEY=
# Google Safe Browsing Lookup API v4 (a Google Cloud API key with the API enabled; free for non-commercial use)
SAFEBROWSING_API_KEY=
# abuse.ch Auth-Key (free account at auth.abuse.ch) - URLhaus rejects calls without it
URLHAUS_API_KEY=
OPENAI_API_KEY=
